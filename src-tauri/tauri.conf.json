{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Overlay Manager",
  "version": "0.1.0",
  "identifier": "com.example.overlaymanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Overlay Manager",
        "width": 1040,
        "height": 700,
        "minWidth": 860,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
